[node name="Dungeon" type="Node2D"]
y_sort_enabled = true
script = ExtResource("1_dungeon_manager")
combat_templates = Array[PackedScene]([ExtResource("9_combat_hall"), ExtResource("10_combat_pillars"), ExtResource("11_combat_wide")])
special_template = ExtResource("12_special_room")
miniboss_template = ExtResource("13_miniboss_room")
boss_template = ExtResource("14_boss_room")
weapon_pool = Array[ExtResource("7_weapon_data")]([ExtResource("15_sword"), ExtResource("16_bow"), ExtResource("17_staff"), ExtResource("90_dagger"), ExtResource("91_hammer")])

[node name="RoomContainer" type="Node2D" parent="."]
y_sort_enabled = true

[node name="PlayerSpawn" type="Marker2D" parent="."]

[node name="UpgradeManager" type="Node" parent="."]
script = ExtResource("2_upgrade_manager")
upgrade_pool = Array[ExtResource("3_upgrade_data")]([ExtResource("18_strong_attack"), ExtResource("19_strength_training"), ExtResource("20_fast_attack"), ExtResource("21_precise_arrows"), ExtResource("22_magic_power"), ExtResource("23_fast_projectiles"), ExtResource("24_shield_boost"), ExtResource("25_pierce"), ExtResource("26_wall_bounce"), ExtResource("27_double_shot"), ExtResource("28_wide_swing"), ExtResource("29_big_explosion"), ExtResource("30_explosive_hit"), ExtResource("31_heal_on_kill"), ExtResource("32_shield_on_kill")])

[node name="UpgradeEffects" type="Node2D" parent="." node_paths=PackedStringArray("upgrade_manager")]
script = ExtResource("4_upgrade_effects")
upgrade_manager = NodePath("../UpgradeManager")

[node name="EconomySystem" type="Node" parent="."]
script = ExtResource("5_economy_system")
config = ExtResource("8_economy_config")

[node name="DungeonUI" type="CanvasLayer" parent="."]
script = ExtResource("6_dungeon_ui")
