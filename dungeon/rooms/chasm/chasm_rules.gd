class_name ChasmRules
extends RefCounted
## Pure rules of abysses (A4, D-086, D-115): when a player falls, what a fall costs,
## which enemies a knockback can push into a pit, and the first-time hint. No nodes, unit-testable;
## PlayerFall, Enemy and PitProbe apply them (decisions here, effects there, D-088).

## A player over an abyss and not dashing falls after this grace time (D-086).
const FALL_GRACE_TIME := 0.1
## Length of the fall animation; input is locked meanwhile (D-086).
const FALL_TIME := 0.5
## A fall costs a whole heart, past the shield (D-086, project member 14.10.2026).
const FALL_DAMAGE := 2.0
## Invulnerable after landing at the last safe spot (D-086).
const RESPAWN_INVULNERABILITY := 1.0
## The feet must be this far inside the abyss on every side before the player counts as over it:
## a little forgiveness at rims and along bridges (px). TESTWERT
const FALL_EDGE_MARGIN := 8.0
## A spot is remembered as "last safe" only with this much floor around the feet (px). TESTWERT
const SAFE_MARGIN := 20.0
## Enemies fall only when a knockback faster than this hits them (px/s, D-086). TESTWERT
const ENEMY_FALL_MIN_KNOCKBACK := 250.0
## A knocked back enemy has its footing again once the knockback is slower than this (px/s).
const ENEMY_SETTLE_SPEED := 30.0
## Sound of a fall (audio/sfx/pit_fall.wav, generated by fx-audio); the dash whoosh until it exists.
const FALL_SOUND := &"pit_fall"
const FALL_SOUND_FALLBACK := &"dash"
## Damage tag of a fall (run recap cause, effects).
const DAMAGE_TAG := &"pit"
## Enemies with this tag are too heavy to be pushed into an abyss (golems, D-086).
const HEAVY_TAG := &"heavy"
## The ingredient "small abyss holes" appears from this room on (D-115: not in 1-5).
const HOLES_FROM_ROOM := 6

## First-time hint for abysses outside a chasm room (small holes in a normal room); the chasm room
## itself explains them with its genre card (RoomGenre, ROOM_CHASM_INTRO).
const HINT_ID := &"hint_chasm"
const HINT_TITLE_KEY := &"HINT_CHASM_TITLE"
const HINT_TEXT_KEY := &"HINT_CHASM_TEXT"


## Time spent over an abyss after delta more seconds: grows while over a pit on foot, back to 0 on
## solid ground and while dashing (in the air, D-086).
static func tick_over_pit(over_time: float, delta: float, over_pit: bool, dashing: bool) -> float:
	if not over_pit or dashing:
		return 0.0
	return over_time + delta


## The one fall decision: over an abyss, not dashing, longer than the grace time.
static func should_fall(over_pit: bool, dashing: bool, over_time: float) -> bool:
	return over_pit and not dashing and over_time >= FALL_GRACE_TIME


## Feet over an abyss: the point and the four points FALL_EDGE_MARGIN around it are pits.
## is_pit(point) -> bool.
static func is_over_pit(feet: Vector2, is_pit: Callable) -> bool:
	for point in sample_points(feet, FALL_EDGE_MARGIN):
		if not is_pit.call(point):
			return false
	return true


## Safe spot to come back to: no pit at the feet or SAFE_MARGIN around them.
static func is_safe_spot(feet: Vector2, is_pit: Callable) -> bool:
	for point in sample_points(feet, SAFE_MARGIN):
		if is_pit.call(point):
			return false
	return true


static func sample_points(center: Vector2, margin: float) -> PackedVector2Array:
	return PackedVector2Array([center, center + Vector2(margin, 0), center - Vector2(margin, 0),
		center + Vector2(0, margin), center - Vector2(0, margin)])


## Damage of a fall; a trial caps it so it never ends the run (TrialRules).
static func fall_damage() -> float:
	return FALL_DAMAGE


static func fall_sound() -> StringName:
	return FALL_SOUND if ResourceLoader.exists(Sfx.SFX_DIR + String(FALL_SOUND) + ".wav") else FALL_SOUND_FALLBACK


## Normal enemies and elites can be pushed into an abyss; champions, golems and bosses never.
static func can_enemy_fall(data: EnemyData, is_champion: bool) -> bool:
	if data == null or data.is_boss or is_champion:
		return false
	return not data.tags.has(HEAVY_TAG)


## Only a strong knockback pushes an enemy over the rim.
static func knockback_can_push(speed: float) -> bool:
	return speed > ENEMY_FALL_MIN_KNOCKBACK


## Distance a knockback of speed slides with friction (px/s²) until it stops.
static func knockback_travel(speed: float, friction: float) -> float:
	if friction <= 0.0:
		return speed
	return speed * speed / (2.0 * friction)


## Hint card for the first abyss outside a chasm room, in the format of EnemyHints entries
## ({id, title, text, badge}); empty when it is not due: no pits, a chasm room (its genre card
## explains), or already seen (seen_intro = the chasm genre card, seen_hint = this card).
static func get_hint_entry(room_has_pits: bool, is_chasm_room: bool, seen_intro: bool, seen_hint: bool) -> Dictionary:
	if not room_has_pits or is_chasm_room or seen_intro or seen_hint:
		return {}
	return {"id": HINT_ID, "title": DungeonTexts.t(HINT_TITLE_KEY), "text": DungeonTexts.t(HINT_TEXT_KEY, [ControlsInfo.key_text(ControlsInfo.DASH)]), "badge": &""}
