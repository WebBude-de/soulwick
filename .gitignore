# Godot editor/import cache (TECHSTACK §3: never versioned)
.godot/

# Python cache of the generator tools (tools/generate_*.py)
__pycache__/
*.pyc

# Personal editor settings (machine-specific paths)
.vscode/

# Scene gallery: regenerated by tools/scene_gallery.gd, only INDEX/AUSWAHL are versioned
docs/design/gallery/*.png

# Raw art deliveries, merged into art/ by hand
_inbox/

# Dev-Feedback (F9): Auswertungen von tools/collect_feedback.py und kopierte Screenshots bleiben
# lokal (gross, jederzeit aus user://dev_feedback neu erzeugbar); nur die Anleitung wird versioniert.
docs/feedback/*
!docs/feedback/README.md

# Isolated user data for local Godot runs (APPDATA redirect)
.userdata/

# Exported game builds (tools/export_build.ps1 / .sh, MP4)
builds/

# Android build template (installed fresh per export, D-156)
/android/

# Standard v2 (/project)
secrets.json
.env
.env.*
*.pem
*.key
.claude/settings.local.json
CLAUDE.local.md
!.env.example
# Art for secret rooms, not a secret (standard v2 audit)
!art/environment/rooms/secrets.json
